<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.intern.ui.controllers.EvaluationController" stylesheets="/css/style.css">
    <children>
        <VBox spacing="12" layoutX="20" layoutY="20">
            <Label text="Evaluations" styleClass="section-title" />
            <HBox spacing="12">
                <VBox spacing="8">
                    <Label text="Internship:" />
                    <ComboBox fx:id="internshipCombo" prefWidth="300" />
                    <Label text="Score (1-10):" />
                    <TextField fx:id="scoreField" />
                    <Label text="Comments:" />
                    <TextArea fx:id="commentsArea" prefRowCount="4" prefWidth="300" />
                    <Button text="Save Evaluation" onAction="#onSaveEvaluation" />
                </VBox>
                <ListView fx:id="evaluationListView" prefWidth="420" prefHeight="360" />
            </HBox>
            <HBox>
                <Button text="Back" onAction="#onBack" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
